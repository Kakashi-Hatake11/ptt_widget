<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- R3 dormant -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#11FF4444"/>
            <size android:width="72dp" android:height="72dp"/>
        </shape>
    </item>
    <!-- R2 glow -->
    <item android:top="7dp" android:left="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#44FF4444"/>
            <size android:width="66dp" android:height="66dp"/>
        </shape>
    </item>
    <!-- R2 sharp -->
    <item android:top="9dp" android:left="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#AAFF5555"/>
            <size android:width="62dp" android:height="62dp"/>
        </shape>
    </item>
    <!-- R1 glow fading -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#44FF4444"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    <!-- R1 sharp fading -->
    <item android:top="14dp" android:left="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#FFFF5555"/>
            <size android:width="52dp" android:height="52dp"/>
        </shape>
    </item>
    <!-- Core glow -->
    <item android:top="17dp" android:left="17dp" android:right="17dp" android:bottom="17dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#44FF4444"/>
            <size android:width="46dp" android:height="46dp"/>
        </shape>
    </item>
    <!-- Core -->
    <item android:top="19dp" android:left="19dp" android:right="19dp" android:bottom="19dp">
        <shape android:shape="oval">
            <solid android:color="#0D1117"/>
            <stroke android:width="2dp" android:color="#FF6666"/>
            <size android:width="42dp" android:height="42dp"/>
        </shape>
    </item>
</layer-list>